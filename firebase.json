{
  "firestore": {
    "rules": "client/firestore.rules",
    "indexes": "client/firestore.indexes.json"
  },
  "storage": {
    "rules": "client/storage.rules"
  },
  "hosting": {
    "target": "landing",
    "public": "landing/out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.git/**", "**/.gitignore", "**/.env*", "**/.DS_Store", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/list",
        "destination": "/list/index.html"
      },
      {
        "source": "/business",
        "destination": "/business/index.html"
      },
      {
        "source": "/en",
        "destination": "/en/index.html"
      },
      {
        "source": "/en/business",
        "destination": "/en/business/index.html"
      },
      {
        "source": "/about",
        "destination": "/about/index.html"
      },
      {
        "source": "/blog",
        "destination": "/blog/index.html"
      },
      {
        "source": "/careers",
        "destination": "/careers/index.html"
      },
      {
        "source": "/contact",
        "destination": "/contact/index.html"
      },
      {
        "source": "/faq",
        "destination": "/faq/index.html"
      },
      {
        "source": "/help",
        "destination": "/help/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy/index.html"
      },
      {
        "source": "/terms",
        "destination": "/terms/index.html"
      },
      {
        "source": "/cookies",
        "destination": "/cookies/index.html"
      },
      {
        "source": "/pricing",
        "destination": "/pricing/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
          }
        ]
      }
    ]
  }
}
